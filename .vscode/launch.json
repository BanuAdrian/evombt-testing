{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: FastAPI Order API",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend",
            "justMyCode": true,
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe"
        }
    ]
}
