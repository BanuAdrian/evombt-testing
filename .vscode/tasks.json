{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start FastAPI Backend",
            "type": "shell",
            "command": "uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Run EvoMBT Pipeline (Generate + Execute)",
            "type": "shell",
            "command": ".\\run_pipeline.bat",
            "options": {
                "cwd": "${workspaceFolder}/evombt-tests"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
